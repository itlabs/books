# 《深入 Triton》：Intel GPU（Max 1100 / PVC）上跑 Triton 3.9.0（triton-xpu）的环境变量模板。
# 复制成 env-xpu.sh，把下面三个占位路径改成你机器上的，然后：
#
#     source env-xpu.sh
#     <venv>/bin/python probe-env.py --helion      # 目标 14/14
#
# 只在 Level Zero loader / GPU 驱动 / ocloc 不在系统目录里时才需要这份文件；
# 用发行版的包（libze1、libze-dev、intel-opencl-icd、intel-ocloc 等）装到 /usr 下的机器，通常什么都不用设。

ZE_LOADER_DIR=/path/to/level_zero_loader     # 有 libze_loader.so，以及 include/level_zero/ze_api.h
GPU_DRIVER_DIR=/path/to/gpu-user-mode-driver # 有 libigc.so、libze_intel_gpu.so 和 ocloc
VENV=/path/to/venv                           # uv venv，装了 torch==2.15.0+xpu（自带 triton-xpu 3.9.0）

# 1. 运行时：只放 Level Zero loader 和 GPU 驱动。
#    不要整个清空（torch.xpu 会看到 0 个设备）；也不要混进自己编译的 DPC++ 的 lib 目录
#    （pip 装的 libsycl 会链到旧的 libur_loader，报 undefined symbol urKernelSetArgLocal）。
export LD_LIBRARY_PATH="$GPU_DRIVER_DIR:$ZE_LOADER_DIR"

# 2. Intel driver 首次运行时要现场编一段 C++ 胶水代码。
#    用 g++：不加 -fsycl，SYCL 头文件改从 pip 包 intel-sycl-rt 里取，不会和别的 DPC++ 版本混。
#    PATH 里不要有自己编译的 dpclang++ / icpx（Triton 会优先挑它们）。
export CXX=g++
#    胶水代码要 #include <level_zero/ze_api.h>，链接要 -lze_loader；pip 包两样都不提供。
export CPATH="$ZE_LOADER_DIR/include${CPATH:+:$CPATH}"
export LIBRARY_PATH="$ZE_LOADER_DIR${LIBRARY_PATH:+:$LIBRARY_PATH}"

# 3. ocloc 必须在 PATH 里。没有它：
#    - torch.compile（Inductor）和 Helion 会报 FileNotFoundError: 'ocloc'；
#    - 更隐蔽的是，没有 OpenCL 平台的机器上，设备扩展查询会悄悄返回 False，
#      tl.dot 结果正确，但 TTGIR 里没有 #ttig.dpas，不走矩阵单元。
export PATH="$VENV/bin:$GPU_DRIVER_DIR:$PATH"
